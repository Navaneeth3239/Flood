# Smart Flood Monitoring & Early Warning System Configuration
# Set to 'true' to use the bundled mock dataset in src/mocks/
VITE_USE_MOCK_DATA=true

# Centralized API Base URL (used when VITE_USE_MOCK_DATA=false)
VITE_API_BASE_URL=http://localhost:8000/api

# Native WebSocket URL for live readings, alerts, and station statuses
VITE_WS_URL=ws://localhost:8000/ws

# Stale data threshold in minutes (warnings displayed if sensor data older than this)
VITE_STALE_DATA_THRESHOLD_MINUTES=15

# Cesium Ion Access Token (Optional: Leave blank to use OpenStreetMap & Ellipsoid/Default terrain without Ion)
VITE_CESIUM_ION_ACCESS_TOKEN=
